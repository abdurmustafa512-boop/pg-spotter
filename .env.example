# StayWise AI Configuration
# Port for the Node.js Express Backend
PORT=5000

# Google Gemini API Key (Optional)
# If left empty, StayWise AI operates automatically in high-fidelity DEMO MODE (Rule-based & pattern engine).
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Environment setting
NODE_ENV=development

# Allowed Frontend Origin for CORS
CORS_ORIGIN=http://localhost:5173
