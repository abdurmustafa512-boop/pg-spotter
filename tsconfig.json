{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": "./dist",\
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames":
true,
     "strict": true,
     "skipLibCheck": true,
     "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules","dist"]
}
